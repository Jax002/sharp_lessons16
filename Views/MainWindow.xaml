<Window x:Class="sharp_lessons16.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Навчальні Завдання" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="Border" x:Key="TaskBorder">
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Background" Value="#D4EDDA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsImportant}" Value="True">
                    <Setter Property="Background" Value="#FFF3CD"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                    <Setter Property="Background" Value="#F8D7DA"/>
                    <Setter Property="BorderBrush" Value="#DC3545"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCompleted}" Value="False">
                    <Setter Property="Background" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TaskTemplate">
            <Border Style="{StaticResource TaskBorder}">
                <StackPanel>
                    <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              FontWeight="Bold" FontSize="14" Margin="0,0,0,5">
                        <CheckBox.Content>
                            <TextBlock Text="{Binding Name}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextDecorations" Value="{x:Null}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </CheckBox.Content>
                    </CheckBox>
                    <TextBlock Text="{Binding Description}" Margin="25,0,0,5" Foreground="Gray" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="25,0,0,0">
                        <TextBlock Text="Дедлайн: " FontWeight="Bold"/>
                        <TextBlock Text="{Binding Deadline, StringFormat=dd.MM.yyyy}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                            <Setter Property="Foreground" Value="#DC3545"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text=" [Важливо]" Foreground="Orange" Visibility="{Binding IsImportant, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text=" [Просрочено]" Foreground="Red" Visibility="{Binding IsOverdue, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                    <Button Content="Видалити" Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                            CommandParameter="{Binding}" HorizontalAlignment="Right" Width="80" Margin="0,5,0,0" Background="LightCoral"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F0F0F0" Margin="5" Padding="10" CornerRadius="5">
            <StackPanel>
                <TextBlock Text="Додати нове завдання" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                <TextBlock Text="Назва:" FontWeight="Bold" Margin="0,5"/>
                <TextBox Text="{Binding NewTaskName, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,10"/>
                <TextBlock Text="Опис:" FontWeight="Bold" Margin="0,5"/>
                <TextBox Text="{Binding NewTaskDescription, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock Text="Дедлайн:" FontWeight="Bold" Margin="0,5"/>
                <DatePicker SelectedDate="{Binding NewTaskDeadline}" Height="30" Margin="0,0,0,10"/>
                <CheckBox Content="Позначити як важливе" IsChecked="{Binding NewTaskIsImportant}" Margin="0,0,0,15"/>
                <Button Content="Додати завдання" Command="{Binding AddTaskCommand}" Height="35" Background="LightGreen" FontSize="14" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="#E8E8E8" Margin="5" Padding="10" CornerRadius="5">
            <StackPanel>
                <TextBlock Text="Список завдань" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Фільтр:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox SelectedValue="{Binding SelectedFilter}" 
          SelectedValuePath="Content"
          Width="120" Margin="0,0,10,0">
                        <ComboBoxItem Content="Всі"/>
                        <ComboBoxItem Content="Виконані"/>
                        <ComboBoxItem Content="Активні"/>
                        <ComboBoxItem Content="Важливі"/>
                        <ComboBoxItem Content="Просрочені"/>
                    </ComboBox>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,5,0"/>
                    <Button Content="Очистити" Command="{Binding ClearFiltersCommand}" Width="70"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="450">
                    <ItemsControl ItemsSource="{Binding FilteredTasks}" ItemTemplate="{StaticResource TaskTemplate}"/>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Window>